@model List<VitaminApp.Models.Vitamin>

<div class="container mt-5">
    <h2 class="mb-4 text-center">Find Food by Vitamin</h2>

    <form method="post" asp-action="Search" class="card p-4 shadow">

        <div class="mb-3">
            <label class="form-label">Select Vitamin</label>
            <select name="vitaminName" class="form-select">
                @foreach (var v in Model)
                {
                    <option value="@v.Name">@v.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Allergen (optional)</label>
            <input type="text" name="allergenName" class="form-control" placeholder="e.g. lactose, nuts" />
        </div>

        <button type="submit" class="btn btn-primary w-100">Search</button>
    </form>
</div>